{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "image-to-excel",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-25",
  "placement": {
    "region": "gcp:asia-northeast3",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "US_EXIT",
        "class_name": "UsExit",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1-us-exit",
      "new_sqlite_classes": ["UsExit"],
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "image-to-excel",
      "database_id": "local-image-to-excel",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "image-to-excel-images"
    }
  ],
  "previews": {}
}