{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "image-to-excel",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-25",
  "placement": {
    "region": "gcp:asia-northeast3",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "US_EXIT",
        "class_name": "UsExit",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1-us-exit",
      "new_sqlite_classes": ["UsExit"],
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "previews": {}
}